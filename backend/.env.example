PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/rpcarshowroom

# Comma-separated list is supported, e.g. for local + deployed frontend:
# CLIENT_ORIGIN=http://localhost:4200,https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:4200

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Email (Gmail example - use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="RP Car Showroom <your_email@gmail.com>"
ADMIN_EMAIL=admin@rpcarshowroom.com

# Razorpay — get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
